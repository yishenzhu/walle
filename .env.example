# LLM API 配置（必填）
OPENAI_API_KEY=sk-xxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# MCP Server Keys（按需填写）
# TAVILY_KEY=tvly-dev-xxxx

# Caddy 基础认证（可选，用 ./scripts/deploy.sh auth <用户> <密码> 生成）
# WALLE_AUTH_USER=admin
# WALLE_AUTH_HASH=$2a$14$...

# Caddy 限流：每个 IP 在窗口内的请求数上限（默认 120 次 / 1 分钟）
# WALLE_RATE_EVENTS=120
# WALLE_RATE_WINDOW=1m

# 站点地址：留空走 :80；配域名后 Caddy 自动申请证书
# WALLE_SITE=walle.example.com

# BYOK：是否允许用户把 base_url 指向内网/本机（默认禁止，防止 SSRF）
# 本机跑 Ollama 时设为 1
# WALLE_ALLOW_PRIVATE_UPSTREAM=0
