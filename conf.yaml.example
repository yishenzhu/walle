log:
  level: "DEBUG"
  path: "logs/agent.log"
  backup_count: 30

telemetry:
  enabled: true
  service_name: "agent"
  otlp:
    endpoint: "http://localhost:4317"
    insecure: true
  console_export: false

tool:
  timeout: 30
  approval:
    rules:
      - [deny, bash(cmd=rm -rf /)]    # 危险命令直接拒绝
      - [allow, bash(cmd=ls -la *)]   # 安全命令自动放行
      - [ask, jupyter]                 # 代码执行默认需人工确认
      - [allow, ask_user]             # 提问工具自动放行
      - [allow, grilling]
    default: ask

feishu:
  webhook: ""          # 自定义机器人 webhook（飞书群 → 设置 → 群机器人 → 添加），留空则不推送
  secret: ""           # 可选：签名校验密钥

# MCP server 配置不在此文件，统一放在 .agent/mcp.yaml（模型可动态添加）
