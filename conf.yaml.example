log:
  level: "DEBUG"
  path: "logs/agent.log"
  backup_count: 30

telemetry:
  enabled: true
  service_name: "agent"
  otlp:
    endpoint: "http://localhost:4317"
    insecure: true
  console_export: false

tool:
  timeout: 30
  approval:
    rules:
      - [deny, bash(cmd=rm -rf /)]
      - [allow, bash(cmd=ls -la *)]
      - [allow, ask_user] 
      - [allow, grilling]
    default: ask

# MCP server 配置不在此文件，统一放在 .agent/mcp.yaml（模型可动态添加）
