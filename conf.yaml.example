log:
  level: "DEBUG"
  path: "logs/agent.log"
  backup_count: 30

telemetry:
  enabled: true
  service_name: "agent"
  otlp:
    endpoint: "http://localhost:4317"
    insecure: true
  console_export: false

tool:
  timeout:
    default: 30
    overrides:
      ask_user: null    # None = 豁免超时（等人回答不设时限）；数值 = 覆盖全局
  approval:
    rules:
      - [deny, bash(cmd=rm -rf /)]    # 危险命令直接拒绝
      - [allow, bash(cmd=ls -la*)]    # 安全命令自动放行（ls -la 开头）
      - [ask, jupyter]                 # 代码执行默认需人工确认
      - [ask, edit]                    # 编辑文件默认需人工确认（改动可见）
      - [allow, "edit(path=.agent/note.md)"]  # 工作笔记 note.md 自动放行
      - [allow, ask_user]             # 提问工具自动放行
      - [allow, read]                 # 读文件自动放行（技能按需加载）
      - [allow, history]              # 历史检索只读，自动放行
      - [allow, new_window]           # 模型主动开新窗口（仅改模型视野，不删原文）
    default: ask

# 会话持久化：历史跨连接/重启保留（attach/resume 的基础）
session:
  storage: "sqlite"              # sqlite | memory
  db_path: "data/session.db"     # sqlite 存储路径（相对项目根）

# 扩展：默认加载 .agent/extensions/ 下全部扩展；enabled 非空 = 白名单，disabled 优先
extension:
  dir: ".agent/extensions"
  enabled: []                    # 例: ["audit", "sandbox"]
  disabled: []

# MCP server 配置不在此文件，统一放在 .agent/mcp.yaml（模型可动态添加）
